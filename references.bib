  author = {Piccardi, Tiziano and Saveski, Martin and Jia, Chenyan and Hancock, Jeffrey T. and Tsai, Jeanne L. and Bernstein, Michael},
  year = 2024,
  month = nov,
  number = {arXiv:2411.14652},
