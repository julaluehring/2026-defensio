  title = {A Systematic Review of Worldwide Causal and Correlational Evidence on Digital Media and Democracy},
  author = {{Lorenz-Spreen}, Philipp and Oswald, Lisa and Lewandowsky, Stephan and Hertwig, Ralph},
  year = 2022,
