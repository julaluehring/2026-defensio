@article{bradyEmotionShapesDiffusion2017,
  title = {Emotion Shapes the Diffusion of Moralized Content in Social Networks},
  author = {Brady, William J. and Wills, Julian A. and Jost, John T. and Tucker, Joshua A. and Bavel, Jay J. Van},
  year = 2017,
  month = jul,
  journal = {Proceedings of the National Academy of Sciences},
  volume = {114},
