@article{eckerWhyMisinformationMust2025,
  title = {Why Misinformation Must Not Be Ignored},
  author = {Ecker, Ullrich K. H. and Tay, Li Qian and Roozenbeek, Jon and {van der Linden}, Sander and Cook, John and Oreskes, Naomi and Lewandowsky, Stephan},
