  author = {Siegel, Erika H. and Sands, Molly K. and {Van den Noortgate}, Wim and Condon, Paul and Chang, Yale and Dy, Jennifer and Quigley, Karen S. and Barrett, Lisa Feldman},
  year = 2018,
