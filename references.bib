@article{dahlkeContextualizingMisinformationUserCentric2025,
  title = {Contextualizing {{Misinformation}}: {{A User-Centric Approach}} to {{Linguistic}} and {{Topical Patterns}} in {{News Consumption}}},
  shorttitle = {Contextualizing {{Misinformation}}},
  author = {Dahlke, Ross and Tu, Fangjing and Wang, Yi-Chia and Lu, Yingdan and Engeda, Blain W and Hancock, Jeffrey T.},
  year = 2025,
