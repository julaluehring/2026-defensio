  title = {Can {{Conspiracy Beliefs Be Beneficial}}? {{Longitudinal Linkages Between Conspiracy Beliefs}}, {{Anxiety}}, {{Uncertainty Aversion}}, and {{Existential Threat}}},
  shorttitle = {Can {{Conspiracy Beliefs Be Beneficial}}?},
  author = {Liekefett, Luisa and Christ, Oliver and Becker, Julia C.},
  year = 2023,
