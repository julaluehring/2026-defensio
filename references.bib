@article{loruSimulationJudgmentLLMs2025,
  title = {The Simulation of Judgment in {{LLMs}}},
  author = {Loru, Edoardo and Nudo, Jacopo and Di Marco, Niccol{\`o} and Santirocchi, Alessandro and Atzeni, Roberto and Cinelli, Matteo and Cestari, Vincenzo and {Rossi-Arnaud}, Clelia and Quattrociocchi, Walter},
  year = 2025,
  month = oct,
  journal = {Proceedings of the National Academy of Sciences},
  volume = {122},
  number = {42},
  pages = {e2518443122},
  publisher = {Proceedings of the National Academy of Sciences},
  doi = {10.1073/pnas.2518443122},
  urldate = {2026-03-17},
  abstract = {Large Language Models (LLMs) are increasingly embedded in evaluative processes, from information filtering to assessing and addressing knowledge gaps through explanation and credibility judgments. This raises the need to examine how such evaluations are built, what assumptions they rely on, and how their strategies diverge from those of humans. We benchmark six LLMs against expert ratings---NewsGuard and Media Bias/Fact Check---and against human judgments collected through a controlled experiment. We use news domains purely as a controlled benchmark for evaluative tasks, focusing on the underlying mechanisms rather than on news classification per se. To enable direct comparison, we implement a structured agentic framework in which both models and nonexpert participants follow the same evaluation procedure: selecting criteria, retrieving content, and producing justifications. Despite output alignment, our findings show consistent differences in the observable criteria guiding model evaluations, suggesting that lexical associations and statistical priors could influence evaluations in ways that differ from contextual reasoning. This reliance is associated with systematic effects: political asymmetries and a tendency to confuse linguistic form with epistemic reliability---a dynamic we term epistemia, the illusion of knowledge that emerges when surface plausibility replaces verification. Indeed, delegating judgment to such systems may affect the heuristics underlying evaluative processes, suggesting a shift from normative reasoning toward pattern-based approximation and raising open questions about the role of LLMs in evaluative processes.},
  keywords = {read},
  file = {C:\Users\luehrija\Zotero\storage\VRA972NB\Loru et al. - 2025 - The simulation of judgment in LLMs.pdf}
}

@article{luehringAngerFearPredict2026,
  title = {Anger and {{Fear Predict Individual Misinformation Sharing But Not Collective Patterns}} on {{Twitter}}},
  author = {Luehring, Jula and Garcia, David and Shetty, Apeksha and Waldherr, Annie},
  year = {In prep.},
  abstract = {While experimental research shows that high-arousal negative emotions like anxiety and anger predict misinformation sharing, the temporal relationship between emotions and engagement with untrustworthy content remains underexplored. Using approximately 29,000 Austrian Twitter users and their tweet history from January 2019 to March 2023, we examine how emotional expressions of anger and fear predict news sharing at collective and individual levels, distinguishing between aggregate temporal dynamics as well as individual emotional traits and states. Results show that untrustworthy news sharing and emotions operate independently at the collective level, responding primarily to external events rather than reinforcing each other. At the individual level, however, users characterized by higher baseline emotions as well as variability and instability are substantially more likely to share untrustworthy news, while sustained fear predicts reduced sharing. Critically, momentary emotional states show no association with misinformation engagement, demonstrating that stable characteristics, not situational fluctuations, predict sharing. These findings reveal a selection rather than contagion process: user characteristics determine who shares misinformation, while external events determine when it spreads, with distinct implications for user-level versus platform-level interventions.},
  langid = {english},
  keywords = {dissertation-paper},
  file = {C:\Users\luehrija\Zotero\storage\U5QSGMDH\Luehring et al. - Anger and Fear Predict Individual Misinformation Sharing But Not Collective Patterns on Twitter.pdf}
}

@article{luhringBestPracticesSourcebased2025,
  title = {Best Practices for Source-Based Research on Misinformation and News Trustworthiness Using {{NewsGuard}}},
  author = {L{\"u}hring, Jula and Metzler, Hannah and Lazzaroni, Ruggero and Shetty, Apeksha and Lasser, Jana},
  year = 2025,
  month = jan,
  journal = {Journal of Quantitative Description: Digital Media},
  volume = {5},
  issn = {2673-8813},
  doi = {10.51685/jqd.2025.003},
  urldate = {2026-02-24},
  abstract = {Researchers need reliable and valid tools to identify cases of untrustworthy information when studying the spread of misinformation on digital platforms. A common approach is to assess the trustworthiness of sources rather than individual pieces of content. One of the most widely used and comprehensive databases for source trustworthiness ratings is provided by NewsGuard. Since creating the database in 2019, NewsGuard has continually added new sources and reassessed existing ones. While NewsGuard initially focused only on the US, the database has expanded to include sources from other countries. In addition to trustworthiness ratings, the NewsGuard database contains various contextual assessments of the sources, which are less often used in contemporary research on misinformation. In this work, we provide an analysis of the content of the NewsGuard database, focusing on the temporal stability and completeness of its ratings across countries, as well as the usefulness of information on political orientation and topics for misinformation studies. We find that trustworthiness ratings and source coverage have remained relatively stable since 2022, particularly for the US, France, Italy, Germany, and Canada, with US-based sources consistently scoring lower than those from other countries. Additional information on the political orientation and topics covered by sources is comprehensive and provides valuable assets for characterizing sources beyond trustworthiness. By evaluating the database over time and across countries, we identify potential pitfalls that compromise the validity of using NewsGuard as a tool for quantifying untrustworthy information, particularly if dichotomous "trustworthy"/"untrustworthy" labels are used. Lastly, we provide recommendations for digital media research on how to avoid these pitfalls and discuss appropriate use cases for the NewsGuard database and source-level approaches in general.},
  copyright = {Copyright (c) 2025 Jula L\"uhring, Hannah Metzler, Ruggero Lazzaroni, Apeksha Shetty, Jana Lasser},
  langid = {english},
  keywords = {computational methods,disinformation,dissertation-paper,misinformation,NewsGuard,source trustworthiness},
  file = {C:\Users\luehrija\Zotero\storage\93IVXA8J\Lühring et al. - 2025 - Best practices for source-based research on misinformation and news trustworthiness using NewsGuard.pdf}
}

@article{luhringEmotionsMisinformationStudies2024,
  title = {Emotions in Misinformation Studies: {{Distinguishing}} Affective State from Emotional Response and Misinformation Recognition from Acceptance},
