  shorttitle = {Computational {{Communication Science}}\textbar{} {{The Temporal Turn}} in {{Communication Research}}},
  author = {Wells, Christopher and Shah, Dhavan V. and Pevehouse, Jon C. and Foley, Jordan and Lukito, Josephine and Pelled, Ayellet and Yang, JungHwan},
  year = 2019,
  month = sep,
  journal = {International Journal of Communication},
  volume = {13},
